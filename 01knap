
public class Knapsack {

    public static void main(String[] args) {

        int[] weight = {10, 20, 30};
        int[] profit = {60, 100, 120};

        int capacity = 50;
        int n = weight.length;

        // Create DP table
        int[][] dp = new int[n + 1][capacity + 1];

        // Fill the DP table
        for (int i = 1; i <= n; i++) {

            for (int w = 0; w <= capacity; w++) {

                // If current item fits
                if (weight[i - 1] <= w) {

                    // Maximum of including or excluding item
                    dp[i][w] = Math.max(
                        profit[i - 1] + dp[i - 1][w - weight[i - 1]],
                        dp[i - 1][w]
                    );
                }

                // If item does not fit, exclude it
                else {
                    dp[i][w] = dp[i - 1][w];
                }
            }
        }

        // Display maximum profit
        System.out.println("Maximum Profit: " +
                           dp[n][capacity]);
    }
}